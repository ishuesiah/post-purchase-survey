generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per order. Upserted incrementally as answers arrive from the
// Thank-you / Order status extension, then synced to order metafields and
// Klaviyo once the order exists. No customer PII is stored here: the order
// email is fetched from the Admin API at sync time and passed straight to
// Klaviyo (data minimization).
model SurveyResponse {
  id           String    @id @default(cuid())
  orderId      String    @unique // numeric Shopify order id, as a string
  shop         String // e.g. hemlockandoak.myshopify.com
  source       String
  sourceDetail String?
  sourceText   String?
  trigger      String?
  surface      String // thank_you | order_status
  version      Int       @default(1)
  answeredAt   DateTime  @default(now()) // first answer time

  // Sync state for metafields + Klaviyo
  syncStatus   String    @default("PENDING") // PENDING | SYNCED | FAILED
  attempts     Int       @default(0)
  nextRetryAt  DateTime  @default(now())
  lastError    String?
  metafieldsAt DateTime?
  klaviyoAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syncStatus, nextRetryAt])
}

// Webhook delivery dedupe (Shopify delivers at-least-once).
model ProcessedWebhook {
  webhookId   String   @id
  topic       String
  processedAt DateTime @default(now())
}
