# Copy to .env for local dev. In production (Sevalla) set these in the
# dashboard instead. Never commit real values.

# From the Partner Dashboard app (shopify app env show)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,write_orders

# Postgres connection string (Sevalla managed DB injects this in prod)
DATABASE_URL=

# Klaviyo private API key, scoped to Profiles write. Optional: if unset,
# the Klaviyo sync step is skipped (metafields still written).
KLAVIYO_PRIVATE_KEY=

# The single store this app serves. Requests/webhooks from any other shop
# are rejected.
SHOP_DOMAIN=hemlockandoak.myshopify.com

# IANA time zone used to display "answered at" times on the admin dashboard.
SHOP_TIMEZONE=America/Vancouver

# Public HTTPS base URL of this app's backend, baked into the checkout UI
# extension at build time (extensions/post-purchase-survey/src/api.js).
# Must be set in the shell/.env when running `shopify app deploy`.
# Usually identical to SHOPIFY_APP_URL.
SURVEY_API_URL=
